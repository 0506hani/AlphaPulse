# ================================
# AlphaVerse - AlphaPulse 환경 변수 설정
# ================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요.
# cp .env.example .env

# ────────────────────────────────
# LLM 설정
# ────────────────────────────────
LLM_PROVIDER=gemini                         # gemini | openai | anthropic
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash              # 사용할 Gemini 모델명
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ────────────────────────────────
# 텔레그램 설정
# ────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_TOKEN_HERE
TELEGRAM_CHAT_ID=7451574219  # 예: -1001234567890

# ────────────────────────────────
# 스케줄 설정
# ────────────────────────────────
SCHEDULE_MORNING=07:00
SCHEDULE_EVENING=18:00
TIMEZONE=Asia/Seoul

# ────────────────────────────────
# 저장소 설정
# ────────────────────────────────
DB_PATH=data/alphapulse.db
REPORT_DIR=data/reports
CACHE_DIR=data/cache
LOG_DIR=logs

# ────────────────────────────────
# 뉴스 수집 설정
# ────────────────────────────────
MAX_ARTICLES=200                            # 수집할 최대 기사 수
MAX_ARTICLE_AGE_HOURS=24                   # 기사 최대 나이 (시간)
NUM_GROUPS=7                               # 생성할 뉴스 그룹 수 (5~10)

# ────────────────────────────────
# RSS 피드 소스 (쉼표로 구분)
# ────────────────────────────────
RSS_FEEDS=https://feeds.reuters.com/reuters/businessNews,https://feeds.bbci.co.uk/news/business/rss.xml,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://www.yna.co.kr/rss/economy.xml,https://www.hankyung.com/feed/economy,https://www.mk.co.kr/rss/30000001/
